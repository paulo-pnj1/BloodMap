rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Usuários (doadores): leitura/escrita do próprio doc; admin pode atualizar (ex: registrar doação)
    match /usuarios/{userId} {
      // Leitura pública apenas de doadores marcados como disponíveis;
      // usuários autenticados (doador ou admin) podem ler todos.
      allow read: if resource.data.disponivel == true || request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (request.auth.uid == userId || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // Pedidos: qualquer autenticado pode criar; leitura para dono ou anônimo (consulta por telefone)
    match /pedidos/{pedidoId} {
      allow create: if request.auth != null || true;
      allow read: if true;
      allow update, delete: if request.auth != null;
    }
    
    // Admins: apenas o próprio admin pode ler seu doc (para verificar permissão no app)
    match /admins/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }
    match /hospitais/{hospitalId} {
      allow read, write: if request.auth != null;
    }
    
    // Logs de atividade administrativa (opcional)
    match /admin_logs/{logId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // Campanhas enviadas pelos hospitais/admins
    match /campanhas/{campanhaId} {
      // Leitura liberada para qualquer usuário (app pode exibir histórico de campanhas)
      allow read: if true;
      // Escrita apenas por administradores autenticados
      allow create: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow update, delete: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
  }
}
